# ── MODO DEL CONECTOR ────────────────────────────────────────────────
# "mock"  -> simula el BUK existente de la empresa. Funciona sin credenciales.
# "real"  -> empuja la postulación al BUK real vía su API REST.
BUK_MODE=mock

# ── SUPABASE (persistencia de la demo desplegada) ────────────────────
# Copiar desde Project Settings > API. La clave secreta solo se usa en servidor.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ── ACCESO AL PANEL PRIVADO DEL RECLUTADOR ──────────────────────────
# Crear una contraseña propia y un secreto aleatorio de al menos 32 caracteres.
PANEL_PASSWORD=
PANEL_SESSION_SECRET=

# ── CONEXIÓN AL BUK EXISTENTE (solo si BUK_MODE=real) ────────────────
# La empresa ya tiene BUK. El conector NO construye una web nueva: solo
# empuja el candidato al apartado Postulados de SU cuenta.
# URL base: https://{tenant}.buk.cl/api/v1/{pais}
BUK_BASE_URL=
BUK_AUTH_TOKEN=

# ── VACANTES DE DESTINO ──────────────────────────────────────────────
# Mapeo referencia de la vacante -> selection_process_id interno de BUK.
# Es lo que permite que cada postulación caiga en su vacante CORRESPONDIENTE.
# Formato: {"REFERENCIA": id, ...}
# Los IDs de ejemplo solo sirven para mock; reemplázalos por los IDs reales antes de activar real.
# Obtener los IDs con GET /recruiting/selection_processes (documentación BUK).
BUK_VACANCY_MAP={"DEV-BE-2026": 123, "DEV-FS-2026": 124, "DA-2026": 456, "UX-2026": 789}

# Valor por defecto si la referencia no está en el mapa.
BUK_SELECTION_PROCESS_ID=123

# Nombre del apartado de destino dentro de la vacante.
BUK_STAGE_NAME=Postulantes

# Origen para el campo referrer de BUK. Su enum NO tiene valor "linkedin";
# "external" es el más cercano. Confirmar con la empresa.
BUK_REFERRER=external

# ID de organización (solo si la API de BUK lo exige en tu tenant)
BUK_COMPANY_ID=
